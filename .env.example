# =============================================================================
# PyroCast Environment Configuration
# Copy this file to .env and fill in values before running locally or in Docker.
# =============================================================================

# Application
PYROCAST_ENV=development
DEBUG=false
SECRET_KEY=change-me-to-a-cryptographically-secure-random-string
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL + PostGIS
POSTGRES_USER=pyrocast
POSTGRES_PASSWORD=pyrocast
POSTGRES_DB=pyrocast
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pyrocast:pyrocast@localhost:5432/pyrocast

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# External Data APIs
NASA_FIRMS_API_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api

# Mapbox (frontend map visualization)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ML / Inference
MODEL_CHECKPOINT_PATH=models/checkpoints
INFERENCE_DEVICE=cpu
PREDICTION_HORIZON_HOURS=24
RASTER_RESOLUTION_METERS=30
